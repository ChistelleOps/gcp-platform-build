
# ========================================
# Terraform
# ========================================

# Downloaded providers and modules
**/.terraform/*

# Local Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
tfplan
tfplan.*

# Terraform crash logs
crash.log
crash.*.log

# Local variable files (may contain secrets)
terraform.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ========================================
# Credentials and secrets
# ========================================

.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# ========================================
# Operating system
# ========================================

.DS_Store

# ========================================
# IDE / Editor
# ========================================

.idea/
.vscode/

# ========================================
# Python (Automation scripts)
# ========================================

__pycache__/
*.pyc
.venv/
